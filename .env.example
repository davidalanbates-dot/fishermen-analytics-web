# Copy to .env and fill in. Never commit .env.
# Fishermen Analytics owns every account below; the team creates them and enters credentials.

# PostgreSQL. Local: the value below works with `npm run dev:local` / `npm run db`.
# Production: the Neon or Supabase connection string, set in Vercel.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/fishermen_analytics

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public URL of the site (no trailing slash). In production on Vercel this MUST be
# https://fishermen-analytics.com: canonical URLs, hreflang, the sitemap, structured data and
# llms.txt are built from it, and robots.txt only allows indexing on the real domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob (media storage). Leave empty locally to store uploads on disk in /media.
BLOB_READ_WRITE_TOKEN=

# Resend (enquiry form emails). Leave empty locally; emails are then logged, not sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=website@fishermen-analytics.com
